new file mode 100644
index 0000000..618a7e6
--- /dev/null
+++ b/game/player.py
@@ -0,0 +1,86 @@
+"""Personaje 3D del jugador: cuerpo, cabeza, brazos y piernas (cubos tacticos).
+
+Jerarquia (todo cuelga del FirstPersonController, que sigue haciendo el movimiento):
+  jugador
+  |- raiz            cuerpo: torso, piernas (giran con el jugador)
+  `- camera_pivot    ojos (cabeceo del raton)
+     |- cabeza       sigue el cabeceo
+     `- rig          hombros: brazos + manos + arma (animables como un bloque)
+Un solo personaje; FPS/TPS solo cambian que partes se dibujan (ver player_camera).
+"""
+from ursina import Entity, Vec3, color
+import math
+
+from .config import PERSONAJE
+
+
+def _caja(padre, pos, esc, col, **kw):
+    return Entity(parent=padre, model='cube', position=pos, scale=esc, color=col, **kw)
+
+
+class Personaje:
+    def __init__(self, jugador):
+        c = PERSONAJE
+        self.jugador = jugador
+        self.pivote = jugador.camera_pivot
+
+        # --- cuerpo ---
+        self.raiz = Entity(parent=jugador)
+        self.torso = Entity(parent=self.raiz, position=(0, .95, 0))        # pivote en la cadera
+        _caja(self.torso, (0, .40, 0), (.46, .80, .26), c['ropa'])
+        _caja(self.torso, (0, .45, .02), (.50, .52, .30), c['chaleco'])     # chaleco
+        _caja(self.torso, (0, .45, -.20), (.34, .46, .14), c['chaleco'])    # mochila
+        _caja(self.torso, (.27, .70, 0), (.06, .12, .12), c['acento'])      # brazalete
+        _caja(self.torso, (0, .85, 0), (.14, .16, .14), c['ropa'])          # cuello
+        self.pierna_i = self._pierna(-.14)
+        self.pierna_d = self._pierna(.14)
+
+        # --- cabeza (sigue el cabeceo de la camara) ---
+        self.cabeza = Entity(parent=self.pivote)
+        _caja(self.cabeza, (0, 0, 0), (.32, .32, .32), c['casco'])
+        _caja(self.cabeza, (0, -.02, .165), (.28, .10, .03), c['visor'])
+        _caja(self.cabeza, (0, .17, 0), (.34, .05, .34), c['casco'])
+
+        # --- hombros / brazos / manos (rig animable) ---
+        self.rig = Entity(parent=self.pivote, position=(0, -.30, 0))
+        self.hombro_d = Entity(parent=self.rig, position=(.28, 0, 0))
+        self.hombro_i = Entity(parent=self.rig, position=(-.28, 0, 0))
+        self.mano_d = Entity(parent=self.rig, position=(.38, -.04, .72))    # ancla del arma
+        self.mano_i = Entity(parent=self.rig, position=(.30, -.17, 1.05))
+        self._brazo_d = self._brazo()
+        self._brazo_i = self._brazo()
+        for m in (self.mano_d, self.mano_i):
+            _caja(m, (0, 0, 0), (.11, .11, .11), c['guante'])
+        self._orientar(self._brazo_d, self.hombro_d, self.mano_d)
+        self.apuntar_mano_izq(self.mano_i.position)
+
+    # ---------------------------------------------------------------
+    def _pierna(self, x):
+        p = Entity(parent=self.raiz, position=(x, .95, 0))                   # pivote en la cadera
+        c = PERSONAJE
+        _caja(p, (0, -.47, 0), (.20, .95, .24), c['ropa'])
+        _caja(p, (0, -.90, .04), (.22, .12, .32), c['guante'])               # bota
+        return p
+
+    def _brazo(self):
+        # origin_z=-.5: el cubo crece desde su origen hacia +z (se orienta al escalar)
+        return Entity(parent=self.rig, model='cube', origin_z=-.5, color=PERSONAJE['ropa'])
+
+    def _orientar(self, brazo, hombro, mano):
+        """Apunta el brazo del hombro a la mano (ambos viven en el espacio del rig)."""
+        d = mano.position - hombro.position
+        largo = max(.01, d.length())
+        brazo.position = hombro.position
+        brazo.rotation = (-math.degrees(math.asin(d.y / largo)), math.degrees(math.atan2(d.x, d.z)), 0)
+        brazo.scale = (.09, .09, largo)
+
+    def apuntar_mano_izq(self, pos):
+        self.mano_i.position = Vec3(*pos)
+        self._orientar(self._brazo_i, self.hombro_i, self.mano_i)
+
+    # ---------------------------------------------------------------
+    def mostrar_cuerpo(self, visible):
+        """FPS: solo brazos y arma. TPS: personaje completo."""
+        if self.raiz.enabled != visible:
+            self.raiz.enabled = visible
+            self.cabeza.enabled = visible
diff --git a/game/player_animation.py b/game/player_animation.py
new file mode 100644
index 0000000..04acd45
--- /dev/null
+++ b/game/player_animation.py
@@ -0,0 +1,66 @@
+"""Animacion procedural del personaje: idle, caminar, correr, saltar y caer.
+
+Solo mueve piernas/torso cuando el cuerpo se dibuja (TPS); los brazos (balanceo al
+andar) siempre, porque en FPS son lo unico visible. La velocidad se deduce del
+desplazamiento, asi sirve igual para andar, correr y el dash.
+"""
+import math
+from ursina import lerp
+
+IDLE, CAMINAR, CORRER, SALTAR, CAER = 'idle', 'caminar', 'correr', 'saltar', 'caer'
+_AMP = {IDLE: 0, CAMINAR: 32, CORRER: 55, SALTAR: 0, CAER: 0}
+
+
+class AnimadorPersonaje:
+    def __init__(self, personaje, jugador):
+        self.p = personaje
+        self.j = jugador
+        self.estado = IDLE
+        self.fase = 0.0
+        self.t = 0.0
+        self.vel = 0.0
+        self.amp = 0.0
+        self.lean = 0.0
+        self._x, self._y, self._z = jugador.x, jugador.y, jugador.z
+
+    def actualizar(self, dt, correr, cuerpo_visible):
+        if dt <= 0:
+            return
+        j, p = self.j, self.p
+        self.t += dt
+        dx, dy, dz = j.x - self._x, j.y - self._y, j.z - self._z
+        self._x, self._y, self._z = j.x, j.y, j.z
+        self.vel = lerp(self.vel, math.hypot(dx, dz) / dt, min(1, 12 * dt))
+
+        if not getattr(j, 'grounded', True):
+            self.estado = SALTAR if dy > 0 else CAER
+        elif self.vel < .4:
+            self.estado = IDLE
+        else:
+            self.estado = CORRER if correr else CAMINAR
+
+        mov = self.estado in (CAMINAR, CORRER)
+        self.fase += self.vel * dt * 1.9 if mov else 0
+        self.amp = lerp(self.amp, _AMP[self.estado], min(1, 10 * dt))
+
+        # brazos (siempre): balanceo vertical/lateral al andar
+        bob = math.sin(self.fase * 2) * (.018 if self.estado == CAMINAR else .03 if mov and correr else 0)
+        p.rig.y = -.30 + bob * (1 if mov else 0)
+        p.rig.x = math.sin(self.fase) * (.012 if mov else 0)
+
+        if not cuerpo_visible:
+            return
+
+        s = math.sin(self.fase) * self.amp
+        if self.estado == SALTAR:
+            ang_i, ang_d = 35, -10
+        elif self.estado == CAER:
+            ang_i = ang_d = 15
+        else:
+            ang_i, ang_d = s, -s
+        k = min(1, 14 * dt)
+        p.pierna_i.rotation_x = lerp(p.pierna_i.rotation_x, ang_i, k)
+        p.pierna_d.rotation_x = lerp(p.pierna_d.rotation_x, ang_d, k)
+        self.lean = lerp(self.lean, 10 if self.estado == CORRER else 0, min(1, 8 * dt))
+        p.torso.rotation_x = self.lean
+        p.torso.scale_y = 1 + math.sin(self.t * 1.8) * .008 * (self.estado == IDLE)
diff --git a/game/player_camera.py b/game/player_camera.py
new file mode 100644
index 0000000..b549221
--- /dev/null
+++ b/game/player_camera.py
@@ -0,0 +1,87 @@
+"""Camaras FPS y TPS sobre el mismo FirstPersonController (sin segunda camara).
+
+La camara de Ursina cuelga de `camera_pivot`, asi que el raton la orbita alrededor del
+personaje. FPS = camara en el pivote; TPS = desplazada atras/arriba/hombro. Pasar de una
+a otra es una mezcla continua (`mezcla` 0..1), sin crear ni destruir nada.
+En TPS, apuntar (clic derecho) acerca la camara a FPS, asi las miras tacticas funcionan.
+"""
+from ursina import Vec3, camera, lerp, raycast, clamp
+
+from .config import CAMARA_TPS
+
+
+class CamaraJugador:
+    def __init__(self, jugador, personaje, es_ignorable):
+        self.j = jugador
+        self.p = personaje
+        self.pivote = jugador.camera_pivot
+        self.es_ignorable = es_ignorable     # p. ej. enemigos: no deben acercar la camara
+        self.cfg = CAMARA_TPS
+        self.modo = 'fps'
+        self.mezcla = 0.0
+        self.recorte = 1.0
+        self._en_reposo = False
+
+    def alternar(self):
+        self.modo = 'tps' if self.modo == 'fps' else 'fps'
+        return self.modo
+
+    @property
+    def ojo(self):
+        return self.pivote.world_position
+
+    def _rayo(self, origen, dir, dist, ignorar):
+        ign = list(ignorar)
+        hit = raycast(origen, dir, distance=dist, ignore=ign, debug=False)
+        for _ in range(4):
+            if hit.hit and self.es_ignorable(hit.entity):
+                ign.append(hit.entity)
+                hit = raycast(origen, dir, distance=dist, ignore=ign, debug=False)
+            else:
+                break
+        return hit
+
+    def actualizar(self, dt, ads=False):
+        c = self.cfg
+        objetivo = 1.0 if (self.modo == 'tps' and not ads) else 0.0
+        self.mezcla = lerp(self.mezcla, objetivo, min(1, c['suavizado'] * dt))
+        if abs(self.mezcla - objetivo) < .004:
+            self.mezcla = objetivo
+        m = self.mezcla
+
+        if m == 0:
+            self.p.mostrar_cuerpo(False)
+            if not self._en_reposo:
+                camera.position = Vec3(0, 0, 0)
+                self._en_reposo = True
+            return
+        self._en_reposo = False
+
+        local = Vec3(c['hombro'] * m, c['altura'] * m, -c['distancia'] * m)
+        piv = self.pivote
+        ojo = piv.world_position
+        destino = ojo + piv.right * local.x + piv.up * local.y + piv.forward * local.z
+        d = destino - ojo
+        largo = d.length()
+        k = 1.0
+        if largo > .01:
+            hit = self._rayo(ojo, d / largo, largo + c['margen'], [self.j])
+            if hit.hit:
+                k = clamp((hit.distance - c['margen']) / largo, 0, 1)
+        # acerca de golpe contra una pared; se aleja suavemente al despejarse
+        self.recorte = k if k < self.recorte else lerp(self.recorte, k, min(1, 6 * dt))
+        camera.position = local * self.recorte
+        self.p.mostrar_cuerpo(m * self.recorte > c['umbral_cuerpo'])
+
+    def apuntar(self):
+        """(origen, direccion) del disparo: sale de los ojos y converge en la mira."""
+        fwd = Vec3(*camera.forward)
+        if self.mezcla < .05:
+            return camera.world_position, fwd
+        cam = camera.world_position
+        hit = raycast(cam, fwd, distance=120, ignore=[self.j], debug=False)
+        punto = hit.world_point if hit.hit else cam + fwd * 120
+        ojo = self.ojo
+        d = punto - ojo
+        n = d.length()
+        return ojo, (d / n if n > .5 else fwd)
